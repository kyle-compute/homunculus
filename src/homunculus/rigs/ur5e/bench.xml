<mujoco model="UR5e at a bench">
  <!--
    The UR5e bolted to a bench, with a mug, a plate and a toy in reach. This is the scene of the rig `ur5e`.

    ur5e.xml and its meshes are MuJoCo Menagerie's universal_robots_ur5e (BSD-3-Clause), unchanged. They are not
    in this folder: rig.toml names the robot, and its files are downloaded and loaded beside this one. The
    lighting and floor are those of Menagerie's own scene.xml.

    The objects are Google Scanned Objects; see objects/README.md.

    Cameras. The robot's own is `realsense`, on a pole at the far edge of the bench, looking back at the arm.
    It has the 42 degree vertical field of view of a RealSense D435i's colour camera (Intel datasheet: 69 x 42
    degrees). The camera's housing is not modelled. `overview` is for people only.
  -->
  <include file="ur5e.xml"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20" offwidth="640" offheight="480"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="bench" rgba="0.5 0.52 0.55 1" specular="0" shininess="0"/>
    <material name="pole" rgba="0.15 0.15 0.16 1"/>
    <model name="mug" file="objects/ACE_Coffee_Mug_Kristen_16_oz_cup/model.xml"/>
    <model name="plate" file="objects/Ecoforms_Plant_Plate_S11Turquoise/model.xml"/>
    <model name="bee" file="objects/Fisher_price_Classic_Toys_Buzzy_Bee/model.xml"/>
  </asset>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" pos="0 0 -0.85" type="plane" material="groundplane"/>
    <body name="bench" pos="0 0.35 0">
      <geom name="benchtop" type="box" size="0.6 0.75 0.025" pos="0 0 -0.025" material="bench"/>
      <geom type="box" size="0.03 0.03 0.4" pos="-0.55 -0.7 -0.45" material="pole"/>
      <geom type="box" size="0.03 0.03 0.4" pos="0.55 -0.7 -0.45" material="pole"/>
      <geom type="box" size="0.03 0.03 0.4" pos="-0.55 0.7 -0.45" material="pole"/>
      <geom type="box" size="0.03 0.03 0.4" pos="0.55 0.7 -0.45" material="pole"/>
      <!-- the camera pole, at the far edge -->
      <geom type="cylinder" size="0.012 0.31" pos="0.35 0.77 0.31" material="pole"/>
    </body>

    <body name="realsense_mount" pos="0.35 1.12 0.62" xyaxes="0.8682 -0.4961 0.0000 -0.2292 -0.4011 0.8869">
      <!-- A MuJoCo camera looks along its -z. -->
      <camera name="realsense" pos="0.0325 0 0.002" xyaxes="-1 0 0 0 1 0" fovy="42"/>
    </body>

    <body name="mug" pos="-0.22 0.56 0.002" euler="0 0 2.4">
      <freejoint name="mug"/>
      <attach model="mug" body="model" prefix="mug_"/>
    </body>
    <body name="plate" pos="0.05 0.52 0.002">
      <freejoint name="plate"/>
      <attach model="plate" body="model" prefix="plate_"/>
    </body>
    <body name="bee" pos="0.3 0.4 0.002" euler="0 0 0.6">
      <freejoint name="bee"/>
      <attach model="bee" body="model" prefix="bee_"/>
    </body>

    <camera name="overview" pos="1.1 1.5 0.8" xyaxes="-0.7071 0.7071 0 -0.2902 -0.2902 0.9119"/>
  </worldbody>
</mujoco>
