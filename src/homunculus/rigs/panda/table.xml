<mujoco model="Franka Emika Panda at a table">
  <!--
    The Panda on a table, with a mug and a bowl in front of it. This is the scene of the rig `panda`.

    panda.xml and its meshes are MuJoCo Menagerie's franka_emika_panda (Apache-2.0), unchanged. They are not in
    this folder: rig.toml names the robot, and its files are downloaded and loaded beside this one. This file
    copies the lighting and floor of Menagerie's own scene.xml.

    The mug and bowl are Google Scanned Objects; see objects/README.md.

    Cameras. The robot's own are `workspace`, fixed across the table and looking back at the robot, and
    `wrist`, on the Panda's hand. MJCF cannot add a child to a body that an included file defines, so `wrist`
    is a mount in rig.toml. `overview` is for people only.
  -->
  <include file="panda.xml"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="tabletop" rgba="0.55 0.52 0.48 1"/>
    <material name="tableleg" rgba="0.3 0.3 0.32 1"/>
    <model name="mug" file="objects/Cole_Hardware_Mug_Classic_Blue/model.xml"/>
    <model name="bowl" file="objects/Cole_Hardware_Bowl_Scirocco_YellowBlue/model.xml"/>
  </asset>

  <worldbody>
    <light pos="0 0 2"/>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" pos="0 0 -0.78" type="plane" material="groundplane"/>

    <!-- The robot's base stands on the table top, at height 0. -->
    <body name="table" pos="0.35 0 0">
      <geom name="tabletop" type="box" size="0.6 0.8 0.02" pos="0 0 -0.02" material="tabletop"/>
      <geom type="box" size="0.025 0.025 0.37" pos="-0.55 -0.75 -0.41" material="tableleg"/>
      <geom type="box" size="0.025 0.025 0.37" pos="-0.55 0.75 -0.41" material="tableleg"/>
      <geom type="box" size="0.025 0.025 0.37" pos="0.55 -0.75 -0.41" material="tableleg"/>
      <geom type="box" size="0.025 0.025 0.37" pos="0.55 0.75 -0.41" material="tableleg"/>
    </body>

    <body name="mug" pos="0.52 0.12 0.002">
      <freejoint name="mug"/>
      <attach model="mug" body="model" prefix="mug_"/>
    </body>
    <body name="bowl" pos="0.5 -0.22 0.002">
      <freejoint name="bowl"/>
      <attach model="bowl" body="model" prefix="bowl_"/>
    </body>

    <!-- 1.3 m in front of the base and 0.85 m up, aimed at the table 0.45 m in front of the base. -->
    <camera name="workspace" pos="1.3 0 0.85" xyaxes="0 1 0 -0.662 0 0.75" fovy="58"/>
    <!-- In front of the arm and to its right. For people watching `homunculus video overview`. -->
    <camera name="overview" pos="1.1 -1.4 0.75" xyaxes="0.841 0.541 0 -0.111 0.173 0.979"/>
  </worldbody>
</mujoco>
